{
  "name": "mhri",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Magnifica Humanitas Redemptoris Iesu — an immersive Good Shepherd artwork",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
